---
import "../styles/btn.css";
---

<header class="topbar">
	<span></span>
	<h3 class="topbar__title">kxsty</h3>

	<ul>
		<li>
			<a
				class="btn btn--secondary btn--sm"
				href="https://github.com/kxsty"
				target="_blank">github</a
			>
		</li>
		<li>
			<a
				class="btn btn--secondary btn--sm"
				href="https://t.me/kxsty"
				target="_blank">telegram</a
			>
		</li>
		<li>
			<a
				class="btn btn--secondary btn--sm"
				href="mailto:constantine.perelygin@gmail.com"
				target="_blank"
			>
				email
			</a>
		</li>
	</ul>
</header>

<style>
	.topbar {
		display: grid;
		align-items: center;
		grid-template-columns: 1fr auto 1fr;
		gap: 1rem;
		height: 2.25rem;
		padding: 0 2rem;
	}

	.topbar > span {
		grid-column: 1;
	}

	.topbar__title {
		grid-column: 2;
		color: var(--color-primary);
		text-align: center;
		margin: 0;
	}

	.topbar > ul {
		grid-column: 3;
		justify-self: end;
		display: flex;
		gap: 0.4rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.topbar ul a {
		flex: 1;
		text-align: center;
	}

	@media (max-width: 768px) {
		.topbar {
			grid-template-columns: auto 1fr;
		}

		.topbar > span {
			display: none;
		}

		.topbar__title {
			grid-column: 1;
			text-align: left;
		}

		.topbar > ul {
			grid-column: 2;
			justify-self: end;
		}
	}
</style>
